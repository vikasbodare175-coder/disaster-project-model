rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) 
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;
      allow update: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'role']);
      allow delete: if false;
    }

    // Incidents collection
    match /incidents/{incidentId} {
      allow read: if true; // Public read for hazard safety awareness
      allow create: if isSignedIn()
        && isValidId(incidentId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.riskLevel in ['Low Risk', 'Medium Risk', 'High Risk']
        && request.resource.data.status in ['Active', 'Investigating', 'Contained', 'Resolved'];
      allow update: if isSignedIn()
        && isValidId(incidentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'severityScore', 'description', 'affectedPopulation']);
      allow delete: if isSignedIn();
    }

    // Citizen SOS calls collection
    match /sos_calls/{callId} {
      allow read: if true;
      allow create: if isValidId(callId)
        && request.resource.data.citizenName is string
        && request.resource.data.citizenName.size() <= 128
        && request.resource.data.urgency in ['Life Threatening', 'Medical Emergency', 'Water Trapped', 'Food / Water Depleted']
        && request.resource.data.status in ['Pending Triage', 'Unit Dispatched', 'Rescued'];
      allow update: if isSignedIn()
        && isValidId(callId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'assignedUnitId']);
      allow delete: if isSignedIn();
    }

    // Shelters collection
    match /shelters/{shelterId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && isValidId(shelterId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.status in ['Open & Accepting', 'Near Capacity', 'Full', 'Standby'];
      allow delete: if isSignedIn();
    }
  }
}
